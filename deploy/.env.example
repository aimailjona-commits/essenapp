# Produktion (VPS): Vorlage für deploy/.env – setup-vps.sh legt sie an und füllt Passwörter zufällig.
# App-Keys (ANTHROPIC_API_KEY, FAL_KEY, APNS_*, REINSTALL_BASE, JOB_SCHEDULES) stehen wie lokal in backend/.env.

# Domain mit DNS-A-Record auf die VPS-IP; daraus werden https://<DOMAIN> und PUBLIC_BASE_URL
DOMAIN=essenapp.example.de
# Postgres-Passwort (nur Buchstaben/Ziffern, steht in der Datenbank-URL)
POSTGRES_PASSWORD=
# UID des Benutzers auf dem VPS (Container laufen als dieser Benutzer, liest backend/secrets/)
APP_UID=1000

# Backups (backup.sh, täglich per cron): verschlüsselt mit dieser Passphrase – zusätzlich im Passwortmanager ablegen,
# sonst sind die Backups bei Verlust des VPS wertlos
BACKUP_PASSPHRASE=
BACKUP_DIR=/var/backups/essenapp
BACKUP_KEEP_DAYS=14
# Optional: zusätzliche Kopie per rsync/SSH, z.B. user@backup.example.de:essenapp/ (leer = nur lokal)
BACKUP_RSYNC_TARGET=
