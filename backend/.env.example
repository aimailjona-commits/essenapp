ANTHROPIC_API_KEY=
# DATABASE_URL=sqlite:///./essenapp.db
#   VPS: postgresql+psycopg://… (setzt deploy/docker-compose.yml, Spezifikation 72)
# PUBLIC_BASE_URL=https://essenapp.example.de   # Basis für Einladungs-/Listen-/Rezept-Links; leer = Adresse der Anfrage
# MODEL_PLANNER=claude-haiku-5-5
# MODEL_FAST=claude-haiku-5-5   # Zutaten → Nährwert-Eintrag (2), Rezept-Import (5), Kühlschrank-Foto (69)
# PLANNER_EFFORT=low
# Optional: fal.ai FLUX schnell für KI-Rezeptfotos (ohne Key nur freie Fotos) und Schritt-Bilder (9, 0,3 ct/Bild)
# FAL_KEY=
# Apple Push (E52): Auth-Key (.p8) aus developer.apple.com › Keys (APNs), Datei nach backend/secrets/ (nicht im Git)
# APNS_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_TOPIC=de.jsenf.essenapp
# Pro (19.8): PAYWALL=1 schaltet Gratis-Grenzen ein (aus = alles frei, Familie)
# PAYWALL=1
# App Store Server API: In-App-Purchase-Key aus App Store Connect › Benutzer und Zugriff › Integrationen
# APPSTORE_KEY_PATH=secrets/SubscriptionKey_XXXXXXXXXX.p8
# APPSTORE_KEY_ID=XXXXXXXXXX
# APPSTORE_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Scheduler (E47)
# SCHEDULER=1            # setzt dev.sh serve automatisch
# REINSTALL_BASE=2026-11-02   # Datum der letzten App-Installation → Erinnerung alle 6 Tage
# JOB_SCHEDULES={"import_offers": "Sa 22:00, Mo 06:00, Mi 06:00, Fr 06:00", "coupon_expiry": "täglich 09:00"}
#   weitere Jobs: weekly_basics (Standard "Mo 06:30", Frühstück & Snacks 23), watch_rhythm ("täglich 08:00",
#   Verbrauchsrhythmus 58); nach jedem Import ohne eigenen Zeitplan: price_history, watch_alarms (Merkliste 27/40),
#   product_facts (Open Food Facts 49, kein Key nötig, max. 30 Suchen je Lauf)
#   coupon_expiry ("täglich 09:00", Coupon-Ablauf 38), week_review ("So 19:00", Wochenrückblick 55),
#   achievements ("täglich 03:00", Erfolge 54); Coupon-Fotos lesen nutzt MODEL_FAST (Haiku)
#   Plan- und Lunchbox-Erinnerung je Mitglied über /me/push/settings (plan_prompt_weekday/-time, lunchbox_push)
