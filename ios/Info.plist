<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Essenapp</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>de.jsenf.essenapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>essenapp</string>
			</array>
		</dict>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Verbindet sich mit deinem Essenapp-Server im Heimnetz.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Für die Sprachsteuerung im Kochmodus („weiter“, „Timer starten“). Es wird nichts aufgenommen oder gespeichert.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Erkennt deine Sprachbefehle im Kochmodus, wenn möglich direkt auf dem iPhone.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Zum Sichern von Rezept-Bildkarten in deinen Fotos.</string>
	<key>NSCameraUsageDescription</key>
	<string>Zum Scannen von Barcodes für deine Merkliste und für Fotos deiner eigenen Rezepte.</string>
	<!-- shortcut: HTTP zum lokalen Backend erlaubt; entfernen, sobald der VPS mit HTTPS läuft (Phase 7) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
